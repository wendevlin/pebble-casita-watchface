{
  "name": "casita-watchface",
  "author": "wendevlin",
  "version": "1.1.0",
  "description": "A cheerful Casita watchface with live badges for weather, steps, date, battery, and Home Assistant temperature — expressions change throughout the day.",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "license": "MIT",
  "dependencies": {},
  "scripts": {
    "resources": "bun tools/build-resources.ts",
    "typecheck": "bun run render-config && tsc -p tsconfig.pkjs.json && tsc -p tsconfig.tools.json",
    "test": "bun run resources && bun test && bun run test:c",
    "render-config": "bun tools/render-config.ts",
    "build:pkjs": "bun run render-config && bun build src/pkjs/index.ts --outfile src/pkjs/index.js --target browser --format iife",
    "build": "bun run resources && bun run build:pkjs && pebble build",
    "clean": "pebble clean",
    "emulator:emery": "pebble install --emulator emery --logs",
    "emulator:gabbro": "pebble install --emulator gabbro --logs",
    "test:c": "mkdir -p build/host-tests && cc -std=c99 -Wall -Wextra -Werror -Isrc/c tests/c/test_logic.c src/c/logic.c -o build/host-tests/test_logic && build/host-tests/test_logic"
  },
  "pebble": {
    "displayName": "Casita",
    "uuid": "ccaf2e63-9f29-4534-877d-23072a555a38",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery",
      "gabbro"
    ],
    "watchapp": {
      "watchface": true
    },
    "capabilities": [
      "configurable",
      "health"
    ],
    "messageKeys": [
      "THEME",
      "WEATHER_TEMP",
      "SHOW_WEATHER",
      "SHOW_STEPS",
      "SHOW_DATE",
      "BADGE_ORDER",
      "SHOW_BATTERY",
      "HA_TEMP",
      "SHOW_HOME_TEMP",
      "SUNRISE",
      "SUNSET",
      "REFRESH"
    ],
    "resources": {
      "media": [
        {
          "type": "raw",
          "name": "CASITA_NORMAL",
          "file": "casita/normal.pdc"
        },
        {
          "type": "raw",
          "name": "CASITA_HAPPY",
          "file": "casita/happy.pdc"
        },
        {
          "type": "raw",
          "name": "CASITA_GRINNING",
          "file": "casita/grinning.pdc"
        },
        {
          "type": "raw",
          "name": "CASITA_SLEEPING",
          "file": "casita/sleeping.pdc"
        },
        {
          "type": "raw",
          "name": "CASITA_DISCONNECTED",
          "file": "casita/disconnected.pdc"
        },
        {
          "type": "raw",
          "name": "CASITA_SWEATING",
          "file": "casita/sweating.pdc"
        },
        {
          "type": "bitmap",
          "name": "ICON_THERMOMETER",
          "file": "icons/thermometer.png"
        },
        {
          "type": "bitmap",
          "name": "ICON_SHOEPRINT",
          "file": "icons/shoeprint.png"
        },
        {
          "type": "bitmap",
          "name": "ICON_CALENDARBLANK",
          "file": "icons/calendarblank.png"
        },
        {
          "type": "bitmap",
          "name": "ICON_BATTERY_LOW",
          "file": "icons/batterylow.png"
        },
        {
          "type": "bitmap",
          "name": "ICON_BATTERY_MEDIUM",
          "file": "icons/batterymedium.png"
        },
        {
          "type": "bitmap",
          "name": "ICON_BATTERY_HIGH",
          "file": "icons/batteryhigh.png"
        },
        {
          "type": "bitmap",
          "name": "ICON_HOME_THERMOMETER",
          "file": "icons/homethermometer.png"
        },
        {
          "type": "png",
          "name": "APP_ICON",
          "file": "icon48.png"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "eta": "^4.6.0",
    "typescript": "^6.0.2"
  }
}
