<div id="view-ha" style="display:none">
  <button type="button" class="back" id="ha-back">&lsaquo; Settings</button>
  <h1>Home Assistant</h1>

  <!-- Not connected (or a not-yet-saved disconnect): enter URL + log in -->
  <div id="ha-disconnected">
    <div class="ha-status" id="ha-pending-note" style="display:none; border-left:4px solid #f44336;">
      Home Assistant will be disconnected when you go back and tap
      <strong>Save</strong> in Settings.
      <div class="url">Nothing is saved yet.</div>
    </div>
    <button type="button" class="link" id="ha-keep" style="display:none">&lsaquo; Keep connected</button>
    <p class="sub">Connect your Home Assistant instance to add a home temperature badge.</p>
    <input type="url" id="ha-url" placeholder="https://your-home.example.com" autocapitalize="off" autocorrect="off" spellcheck="false">
    <p class="hint">Use a <strong>remote</strong> URL (e.g. your Nabu Casa address or a reverse-proxied https URL) so the watch works everywhere, not just on your home Wi&#8209;Fi.</p>
    <p class="hint">Recommended: create a <strong>dedicated Home Assistant user</strong> for the watch with limited permissions instead of using your admin account.</p>
    <div class="ha-status" style="border-left:4px solid #ff9800;">
      After you tap log in, Home Assistant opens its own login screen and
      <strong>Settings will close</strong>. Reopen Settings from the Pebble
      app afterwards to pick your sensor and save.
    </div>
    <button type="button" id="ha-login">Log in to Home Assistant</button>
  </div>

  <!-- Connected: status, sensor picker, disconnect -->
  <div id="ha-connected" style="display:none">
    <div class="card">
      <div class="ha-status ok">
        &#10003; Connected
        <div class="url" id="ha-url-shown"></div>
      </div>
      <button type="button" class="danger" id="ha-disconnect">Disconnect</button>
    </div>
    <div class="ha-status" id="ha-unsaved-note" style="display:none; border-left:4px solid #18bcf2;">
      Not saved yet — go back and tap <strong>Save</strong> in Settings to apply.
    </div>
    <p class="sub" id="ha-sensors"></p>
    <legend>Home temperature sensor</legend>

    <!-- A sensor is chosen: show it with a Remove button (no list). -->
    <div id="ha-selected" style="display:none">
      <div class="card">
        <div class="picker-item selected">
          <div class="meta">
            <div class="name" id="ha-selected-name"></div>
            <div class="area" id="ha-selected-area"></div>
            <div class="area" id="ha-selected-value"></div>
          </div>
        </div>
        <button type="button" class="secondary" id="ha-remove">Remove sensor</button>
      </div>
    </div>

    <!-- No sensor chosen yet: search + selectable list. -->
    <div id="ha-picker-wrap">
      <input type="text" class="search" id="ha-search" placeholder="Search sensors…" autocapitalize="off" autocorrect="off" spellcheck="false">
      <div class="picker">
        <div class="picker-list" id="ha-picker"></div>
      </div>
      <p class="hint">Pick the temperature sensor for the home badge, then go back and tap <strong>Save</strong> in Settings. Names and areas come from Home Assistant.</p>
    </div>
  </div>

  <button type="button" class="back" id="ha-back-bottom">&lsaquo; Back to Settings</button>
</div>
