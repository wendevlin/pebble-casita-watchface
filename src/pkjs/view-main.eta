<div id="view-main">
  <h1>Casita</h1>
  <p class="sub">Watchface settings</p>
  <fieldset>
    <legend>Appearance</legend>
    <select name="theme">
      <% it.themes.forEach(function (t) { %>
      <option value="<%= t.value %>"><%= t.label %></option>
      <% }) %>
    </select>
  </fieldset>
  <fieldset>
    <legend>Badges</legend>
    <p class="hint">Toggle badges and use ▲ ▼ to set their priority: the first badge sits top right and the rest fill leftwards, wrapping to a second row. On round watches the rows hold one, two and two.</p>
    <ul class="badges" id="badges">
      <% it.badges.forEach(function (b) { %>
      <li class="badge" data-badge="<%= b.name %>"<% if (b.name === 'home') { %> style="display:none"<% } %>>
        <label><input type="checkbox" name="<%= b.name %>"> <%= b.label %></label>
        <span class="reorder">
          <button type="button" class="up" aria-label="Move up">&#9650;</button>
          <button type="button" class="down" aria-label="Move down">&#9660;</button>
        </span>
      </li>
      <% }) %>
    </ul>
  </fieldset>
  <fieldset>
    <legend>Home Assistant</legend>
    <button type="button" class="ha-entry" id="ha-open">
      <span class="dot"></span>
      <span id="ha-entry-label">Connect Home Assistant</span>
      <span class="chev">&rsaquo;</span>
    </button>
  </fieldset>
  <button type="submit">Save</button>
</div>
