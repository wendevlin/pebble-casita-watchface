<%
/*
 * Casita settings page (phone-side config UI).
 *
 * Rendered ONCE at build time by tools/render-config.mjs into
 * src/pkjs/config-html.ts. There is no per-user data baked in here: the current
 * preferences are injected at runtime as a JSON blob in place of the literal
 * __CONFIG__ token below, and the inline script applies them to the controls.
 *
 * The page is a tiny two-view SPA: the main settings view and a dedicated Home
 * Assistant view. Navigation between them is client-side (show/hide), so opening
 * the HA page does NOT close settings. Only two things actually close the
 * webview (the platform's one channel back to pkjs, via pebblejs://close#):
 * Save (which also commits a deferred disconnect) and the HA login redirect.
 */
%><!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Casita Settings</title>
    <style>
      body { font-family: -apple-system, Roboto, Helvetica, sans-serif; margin: 0; padding: 24px; background: #f2f4f9; color: #1c1c1e; }
      h1 { font-size: 20px; margin: 0 0 4px; }
      p.sub { margin: 0 0 24px; color: #6b7280; font-size: 14px; }
      fieldset { border: none; padding: 0; margin: 0 0 24px; }
      legend { font-size: 13px; text-transform: uppercase; letter-spacing: .05em; color: #6b7280; margin-bottom: 8px; }
      label { display: flex; align-items: center; gap: 12px; background: #fff; border-radius: 12px; padding: 16px; margin-bottom: 8px; font-size: 17px; }
      input[type=radio], input[type=checkbox] { width: 20px; height: 20px; accent-color: #18bcf2; }
      button { width: 100%; border: none; border-radius: 12px; padding: 16px; font-size: 17px; font-weight: 600; color: #fff; background: #18bcf2; }
      button.secondary { background: #eef0f4; color: #1c1c1e; }
      button.danger { background: #fff; color: #f44336; box-shadow: inset 0 0 0 2px #f44336; }
      input[type=url], input.search { width: 100%; box-sizing: border-box; border: 1px solid #d0d4de; border-radius: 12px; padding: 14px; font-size: 16px; margin-bottom: 8px; background: #fff; }
      ul.badges { list-style: none; padding: 0; margin: 0; }
      li.badge { display: flex; align-items: center; background: #fff; border-radius: 12px; margin-bottom: 8px; padding-right: 8px; }
      li.badge label { flex: 1; background: none; border-radius: 0; margin: 0; }
      .reorder { display: flex; gap: 6px; }
      .reorder button { width: 42px; padding: 10px 0; font-size: 15px; color: #1c1c1e; background: #eef0f4; }
      .reorder button:disabled { opacity: .35; }
      p.hint { margin: -4px 0 8px; color: #6b7280; font-size: 12px; }

      /* Home Assistant entry button (deliberately distinct from Save) */
      button.ha-entry { display: flex; align-items: center; gap: 10px; justify-content: flex-start; background: #fff; color: #1c1c1e; box-shadow: inset 0 0 0 2px #d0d4de; margin-bottom: 8px; }
      button.ha-entry .dot { width: 10px; height: 10px; border-radius: 50%; background: #b0b6c0; flex: none; }
      button.ha-entry.connected { box-shadow: inset 0 0 0 2px #18bcf2; }
      button.ha-entry.connected .dot { background: #4caf50; }
      button.ha-entry .chev { margin-left: auto; color: #9aa0aa; }

      /* Dedicated HA view */
      .nav { margin: 0 0 12px; }
      button.link { width: auto; padding: 6px 0; background: none; color: #18bcf2; font-size: 15px; font-weight: 600; }
      .ha-status { background: #fff; border-radius: 12px; padding: 16px; margin-bottom: 8px; font-size: 16px; }
      .ha-status.ok { border-left: 4px solid #4caf50; }
      .ha-status .url { color: #6b7280; font-size: 13px; word-break: break-all; margin-top: 4px; }

      /* Entity picker (mirrors the HA frontend: name + area) */
      .picker { background: #fff; border-radius: 12px; overflow: hidden; margin-bottom: 8px; }
      .picker-list { max-height: 260px; overflow-y: auto; }
      .picker-item { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border-top: 1px solid #eef0f4; cursor: pointer; }
      .picker-item:first-child { border-top: none; }
      .picker-item .meta { flex: 1; min-width: 0; }
      .picker-item .name { font-size: 16px; }
      .picker-item .area { font-size: 12px; color: #6b7280; }
      .picker-item .check { color: #18bcf2; font-weight: 700; visibility: hidden; }
      .picker-item.selected { background: #eaf7fd; }
      .picker-item.selected .check { visibility: visible; }
      .picker-empty { padding: 16px; color: #6b7280; font-size: 14px; }
    </style>
  </head>
  <body>
    <form id="form">
      <!-- ===================== MAIN SETTINGS VIEW ===================== -->
      <div id="view-main">
        <h1>Casita</h1>
        <p class="sub">Watchface settings</p>
        <fieldset>
          <legend>Appearance</legend>
          <% it.themes.forEach(function (t) { %>
          <label><input type="radio" name="theme" value="<%= t.value %>"> <%= t.label %></label>
          <% }) %>
        </fieldset>
        <fieldset>
          <legend>Clock</legend>
          <label><input type="checkbox" name="seconds"> Show seconds when the light is on</label>
          <p class="hint">Raise your wrist, shake, or tap to light the screen and reveal seconds for a few seconds.</p>
        </fieldset>
        <fieldset>
          <legend>Badges</legend>
          <p class="hint">Toggle badges and use ▲ ▼ to set their left-to-right order.</p>
          <ul class="badges" id="badges">
            <% it.badges.forEach(function (b) { %>
            <li class="badge" data-badge="<%= b.name %>">
              <label><input type="checkbox" name="<%= b.name %>"> <%= b.label %></label>
              <span class="reorder">
                <button type="button" class="up" aria-label="Move up">&#9650;</button>
                <button type="button" class="down" aria-label="Move down">&#9660;</button>
              </span>
            </li>
            <% }) %>
          </ul>
        </fieldset>
        <fieldset>
          <legend>Home Assistant</legend>
          <button type="button" class="ha-entry" id="ha-open">
            <span class="dot"></span>
            <span id="ha-entry-label">Connect Home Assistant</span>
            <span class="chev">&rsaquo;</span>
          </button>
        </fieldset>
        <button type="submit">Save</button>
      </div>

      <!-- ===================== HOME ASSISTANT VIEW ===================== -->
      <div id="view-ha" style="display:none">
        <div class="nav"><button type="button" class="link" id="ha-back">&lsaquo; Settings</button></div>
        <h1>Home Assistant</h1>

        <!-- Not connected: enter URL + log in -->
        <div id="ha-disconnected">
          <p class="sub">Connect your Home Assistant instance to add a home temperature badge.</p>
          <input type="url" id="ha-url" placeholder="https://your-home.example.com" autocapitalize="off" autocorrect="off" spellcheck="false">
          <p class="hint">Use a <strong>remote</strong> URL (e.g. your Nabu Casa address or a reverse-proxied https URL) so the watch works everywhere, not just on your home Wi&#8209;Fi.</p>
          <p class="hint">Recommended: create a <strong>dedicated Home Assistant user</strong> for the watch with limited permissions instead of using your admin account.</p>
          <button type="button" id="ha-login">Log in to Home Assistant</button>
        </div>

        <!-- Connected: status, sensor picker, disconnect -->
        <div id="ha-connected" style="display:none">
          <div class="ha-status ok" id="ha-connected-status">
            &#10003; Connected
            <div class="url" id="ha-url-shown"></div>
          </div>
          <div class="ha-status" id="ha-pending-status" style="display:none; border-left:4px solid #f44336;">
            Will disconnect when you tap <strong>Save</strong>.
            <div class="url">Tap “Keep connected” to undo.</div>
          </div>
          <div id="ha-connected-body">
            <p class="sub" id="ha-sensors"></p>
            <legend>Home temperature sensor</legend>
            <input type="text" class="search" id="ha-search" placeholder="Search sensors…" autocapitalize="off" autocorrect="off" spellcheck="false">
            <div class="picker">
              <div class="picker-list" id="ha-picker"></div>
            </div>
            <p class="hint">Pick the temperature sensor for the home badge, then tap Save. Names and areas come from Home Assistant.</p>
          </div>
          <button type="submit">Save</button>
          <button type="button" class="danger" id="ha-disconnect">Disconnect Home Assistant</button>
        </div>
      </div>
    </form>

    <script>
      var CFG = __CONFIG__;
      var HA = CFG.ha || {};
      var form = document.getElementById('form');
      var badgeList = document.getElementById('badges');

      // --- Main settings controls ----------------------------------------
      var themeInput = form.querySelector('input[name=theme][value="' + CFG.theme + '"]');
      if (themeInput) themeInput.checked = true;
      ['weather', 'steps', 'date', 'battery'].forEach(function (key) {
        var el = form.querySelector('input[name=' + key + ']');
        if (el) el.checked = !!CFG[key];
      });
      var secondsInput = form.querySelector('input[name=seconds]');
      if (secondsInput) secondsInput.checked = !!CFG.seconds;

      function badgeItems() {
        return Array.prototype.slice.call(badgeList.querySelectorAll('li.badge'));
      }
      function refreshArrows() {
        var items = badgeItems();
        items.forEach(function (li, i) {
          li.querySelector('.up').disabled = i === 0;
          li.querySelector('.down').disabled = i === items.length - 1;
        });
      }
      (CFG.order || []).forEach(function (name) {
        var li = badgeList.querySelector('li.badge[data-badge="' + name + '"]');
        if (li) badgeList.appendChild(li);
      });
      refreshArrows();
      badgeList.addEventListener('click', function (e) {
        var button = e.target;
        if (!button || button.tagName !== 'BUTTON') return;
        var li = button.parentNode.parentNode;
        if (button.className === 'up' && li.previousElementSibling) {
          badgeList.insertBefore(li, li.previousElementSibling);
        } else if (button.className === 'down' && li.nextElementSibling) {
          badgeList.insertBefore(li.nextElementSibling, li);
        }
        refreshArrows();
      });

      // --- View navigation (client-side; does NOT close the page) ---------
      var viewMain = document.getElementById('view-main');
      var viewHa = document.getElementById('view-ha');
      function showView(name) {
        var ha = name === 'ha';
        viewHa.style.display = ha ? 'block' : 'none';
        viewMain.style.display = ha ? 'none' : 'block';
        window.scrollTo(0, 0);
      }

      // HA entry button reflects the connection state and opens the HA view.
      var entry = document.getElementById('ha-open');
      var entryLabel = document.getElementById('ha-entry-label');
      if (HA.connected) {
        entry.className = 'ha-entry connected';
        entryLabel.textContent = 'Manage Home Assistant';
      }
      entry.addEventListener('click', function () { showView('ha'); });
      document.getElementById('ha-back').addEventListener('click', function () { showView('main'); });

      // --- Home Assistant view -------------------------------------------
      var connectedBox = document.getElementById('ha-connected');
      var disconnectedBox = document.getElementById('ha-disconnected');
      var selectedSensor = HA.selected || '';

      // Entity picker: search box + selectable list showing name + area, like
      // the Home Assistant frontend entity picker.
      var pickerEl = document.getElementById('ha-picker');
      var allSensors = [];
      function matches(sensor, q) {
        q = (q || '').trim().toLowerCase();
        if (q === '') return true;
        return (sensor.name || '').toLowerCase().indexOf(q) >= 0 ||
               (sensor.area || '').toLowerCase().indexOf(q) >= 0 ||
               (sensor.entity_id || '').toLowerCase().indexOf(q) >= 0;
      }
      function renderPicker(query) {
        pickerEl.innerHTML = '';
        var rows = [{ entity_id: '', name: 'None', area: 'No home temperature badge' }];
        allSensors.forEach(function (s) { if (matches(s, query)) rows.push(s); });
        if (rows.length === 1 && (query || '').trim() !== '') {
          var empty = document.createElement('div');
          empty.className = 'picker-empty';
          empty.textContent = 'No sensors match "' + query + '".';
          pickerEl.appendChild(empty);
          return;
        }
        rows.forEach(function (s) {
          var item = document.createElement('div');
          item.className = 'picker-item' + (s.entity_id === selectedSensor ? ' selected' : '');
          item.setAttribute('data-id', s.entity_id);
          var meta = document.createElement('div');
          meta.className = 'meta';
          var name = document.createElement('div');
          name.className = 'name';
          name.textContent = s.name || s.entity_id;
          meta.appendChild(name);
          if (s.area) {
            var area = document.createElement('div');
            area.className = 'area';
            area.textContent = s.area;
            meta.appendChild(area);
          }
          var check = document.createElement('div');
          check.className = 'check';
          check.innerHTML = '&#10003;';
          item.appendChild(meta);
          item.appendChild(check);
          pickerEl.appendChild(item);
        });
      }
      function buildPicker(list) {
        allSensors = list || [];
        renderPicker('');
      }

      if (HA.connected) {
        connectedBox.style.display = 'block';
        disconnectedBox.style.display = 'none';
        document.getElementById('ha-url-shown').textContent = HA.url || '';
        var n = (HA.list || []).length;
        document.getElementById('ha-sensors').textContent =
          n + (n === 1 ? ' temperature sensor available.' : ' temperature sensors available.');
        buildPicker(HA.list || []);
      } else {
        connectedBox.style.display = 'none';
        disconnectedBox.style.display = 'block';
      }

      if (pickerEl) {
        pickerEl.addEventListener('click', function (e) {
          var item = e.target;
          while (item && item !== pickerEl && item.className.indexOf('picker-item') < 0) {
            item = item.parentNode;
          }
          if (!item || item === pickerEl) return;
          selectedSensor = item.getAttribute('data-id') || '';
          var items = pickerEl.querySelectorAll('.picker-item');
          for (var i = 0; i < items.length; i++) {
            items[i].className = 'picker-item' +
              (items[i].getAttribute('data-id') === selectedSensor ? ' selected' : '');
          }
        });
        var search = document.getElementById('ha-search');
        if (search) {
          search.addEventListener('input', function () { renderPicker(search.value); });
        }
      }

      // --- OAuth login (navigates away to HA, then closes via the callback) --
      // This webview is sandboxed and cannot import src/pkjs/ha.ts, so the
      // base64url + state format below MUST stay in sync with that module.
      var B64 = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_';
      function base64UrlEncode(str) {
        var enc = encodeURIComponent(str);
        var bytes = [];
        for (var i = 0; i < enc.length; i++) {
          if (enc.charAt(i) === '%') { bytes.push(parseInt(enc.substr(i + 1, 2), 16)); i += 2; }
          else { bytes.push(enc.charCodeAt(i)); }
        }
        var out = '';
        for (var j = 0; j < bytes.length; j += 3) {
          var b0 = bytes[j];
          var b1 = j + 1 < bytes.length ? bytes[j + 1] : 0;
          var b2 = j + 2 < bytes.length ? bytes[j + 2] : 0;
          out += B64.charAt(b0 >> 2);
          out += B64.charAt(((b0 & 3) << 4) | (b1 >> 4));
          out += j + 1 < bytes.length ? B64.charAt(((b1 & 15) << 2) | (b2 >> 6)) : '';
          out += j + 2 < bytes.length ? B64.charAt(b2 & 63) : '';
        }
        return out;
      }
      function normalizeHaUrl(input) {
        var url = (input || '').trim();
        if (url === '') return '';
        if (!/^https?:\/\//i.test(url)) url = 'https://' + url;
        return url.replace(/\/+$/, '');
      }
      var loginBtn = document.getElementById('ha-login');
      if (loginBtn) {
        loginBtn.addEventListener('click', function () {
          var haUrl = normalizeHaUrl(document.getElementById('ha-url').value);
          if (!haUrl) { alert('Please enter your Home Assistant URL.'); return; }
          var nonce = String(Math.floor(Math.random() * 1e9)) + '-' + String(Date.now());
          var state = base64UrlEncode(JSON.stringify({ u: haUrl, n: nonce }));
          var authorizeUrl = haUrl + '/auth/authorize?client_id=' +
            encodeURIComponent(HA.clientId) + '&redirect_uri=' +
            encodeURIComponent(HA.redirectUri) + '&response_type=code&state=' +
            encodeURIComponent(state);
          window.location.href = authorizeUrl;
        });
      }
      // Disconnect is deferred: it does NOT close the page. Tapping it marks a
      // pending disconnect (with a banner + undo) and hides the picker; the
      // connection is only actually cleared when the user taps Save. This keeps
      // the flow inside the page — symmetric with connecting, after which you
      // land back here to search and pick a sensor before saving.
      var pendingDisconnect = false;
      var disconnectBtn = document.getElementById('ha-disconnect');
      function applyPendingDisconnect() {
        var connectedStatus = document.getElementById('ha-connected-status');
        var pendingStatus = document.getElementById('ha-pending-status');
        var body = document.getElementById('ha-connected-body');
        if (connectedStatus) connectedStatus.style.display = pendingDisconnect ? 'none' : 'block';
        if (pendingStatus) pendingStatus.style.display = pendingDisconnect ? 'block' : 'none';
        if (body) body.style.display = pendingDisconnect ? 'none' : 'block';
        if (disconnectBtn) {
          disconnectBtn.textContent = pendingDisconnect
            ? 'Keep Home Assistant connected' : 'Disconnect Home Assistant';
          disconnectBtn.className = pendingDisconnect ? 'secondary' : 'danger';
        }
      }
      if (disconnectBtn) {
        disconnectBtn.addEventListener('click', function () {
          pendingDisconnect = !pendingDisconnect;
          applyPendingDisconnect();
        });
      }

      // --- Save (closes the page; the platform's only channel back to pkjs) --
      // Both Save buttons submit this one form. pkjs (index.ts) receives the
      // payload in webviewclosed, stores it, and sends it to the watch.
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var payload = {
          theme: form.querySelector('input[name=theme]:checked').value,
          weather: form.querySelector('input[name=weather]').checked,
          steps: form.querySelector('input[name=steps]').checked,
          date: form.querySelector('input[name=date]').checked,
          battery: form.querySelector('input[name=battery]').checked,
          order: badgeItems().map(function (li) { return li.getAttribute('data-badge'); }),
          seconds: form.querySelector('input[name=seconds]').checked,
          haSensor: selectedSensor,
          haDisconnect: pendingDisconnect
        };
        location.href = 'pebblejs://close#' + encodeURIComponent(JSON.stringify(payload));
      });

      // Open straight into the HA view when pkjs asks (e.g. right after connecting).
      showView(CFG.view === 'ha' ? 'ha' : 'main');
    </script>
  </body>
</html>
